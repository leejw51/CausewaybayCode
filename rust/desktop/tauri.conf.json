{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Causewaybay Code",
  "version": "0.1.0",
  "identifier": "app.causewaybay.code",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Causewaybay Code",
        "width": 1320,
        "height": 860,
        "minWidth": 380,
        "minHeight": 520,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "A local AI coding agent",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/cwbcode"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "files": {
        "Resources/mlx.metallib": "binaries/mlx.metallib"
      }
    }
  }
}
