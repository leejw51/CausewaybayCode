*.pem
*.key
.env
.env.*
!.env.example
*.p12
*.sqlite
*.sqlite3
token
*.db
*.db-wal
*.db-shm
*.log
*.pid
*.sock
playwright-report/
test-results/
.run.json
# Worktrees Claude Code makes for a branch of its own
.claude/worktrees/
